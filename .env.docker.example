APP_NAME="EcclesiaOS Central Support"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_PORT=8090

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_DATABASE=ecclesia_support
DB_USERNAME=ecclesia
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=ecclesiaos_support_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CENTRAL_SUPPORT_AGENT_TOKEN=change-this-agent-token
CENTRAL_SUPPORT_TOKEN_PREFIX=eco_

# Used only by the authenticated dashboard's "Update from GitHub" button.
# Keep this secret and use a long random value.
UPDATE_AGENT_TOKEN=change-this-update-agent-token
UPDATE_REF=main
